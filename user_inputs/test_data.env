# Test Data Excel processing controls (KEY=VALUE)
#
# This file is used by the standard EIDAT pipeline when processing Excel files whose
# metadata "Document Type" resolves to Test Data (TD).
#
# Notes:
# - Values here are defaults. Any same-named environment variables override these.
# - Use 0/1 for booleans.
#

# Enable fuzzy matching for Excel column headers (helps match headers like "Thrust (lbf)" -> "thrust").
EIDAT_TEST_DATA_FUZZY_HEADER_STICK=1

# Minimum similarity ratio (0.0-1.0) for a fuzzy match to be accepted.
EIDAT_TEST_DATA_FUZZY_HEADER_MIN_RATIO=0.82

# Auto-detect header row in Excel extraction when config header_row=0 (recommended for Test Data).
EIDAT_TEST_DATA_AUTO_DETECT_HEADER_ROW=1

# Debug logging (0/1) for header detection + fuzzy matching.
EIDAT_TEST_DATA_FUZZY_DEBUG=0

# Debug table preview (0/1) showing Excel-row coordinates + KEEP/DROP decisions.
# Set to 1 to always print the row filter preview tables during TD Excel processing.
EIDAT_TEST_DATA_DEBUG_TABLE=1

# SQLite mirror export to Excel (0/1). When enabled, TD per-document SQLite files written into
# `EIDAT Support/debug/ocr/<name>__excel/` will also get a `<db>.sqlite3.xlsx` mirror next to them.
EIDAT_TEST_DATA_SQLITE_MIRROR_XLSX=1

# Folder-derived asset identity for Excel TD sources (0/1, default 0).
# When 1, an Excel source whose extracted asset_type / asset_specific_type is Unknown takes
# them from its folder names, `<AssetType>/<AssetSpecificType>/<file>.xlsx` (the fallback
# .mat bundles already use). Use this when the same serial number lives under two different
# asset folders and the workbook contents do not name the asset: each copy then becomes its own
# serial object (Program / Asset / Type / Serial). Changing this re-identifies existing Unknown
# Excel sources on their next processing run, so enable it before (re)processing a node.
EIDAT_TEST_DATA_FOLDER_ASSET_HINTS=0
